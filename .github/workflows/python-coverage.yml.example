name: Python Coverage

on:
  pull_request:
    branches: [main]

permissions:
  contents: read
  pull-requests: write

jobs:
  coverage:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pytest pytest-cov coverage

      - name: Generate coverage and enforce minimum
        run: |
          pytest --cov=src --cov-report=term-missing --cov-report=xml -vv
          coverage report --fail-under=80

      - name: Create markdown coverage report
        run: |
          coverage report --format=markdown > coverage_report.md

      - name: Comment coverage on PR
        uses: mshick/add-pr-comment@v2
        with:
          message-path: coverage_report.md